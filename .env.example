# Bu fayl faqat qaysi environment variable'lar kerakligini ko'rsatadi.
# Haqiqiy qiymatlarni bu yerga yozmang: ularni Netlify Dashboard'ning
# Site configuration -> Environment variables bo'limiga kiritasiz.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
# Bir nechta chat bo'lsa vergul bilan: 123456789,-1001234567890
TELEGRAM_CHAT_ID=
# MAJBURIY (usiz bot tugmalari ishlamaydi): o'zingiz o'ylab topgan uzun tasodifiy matn
TELEGRAM_WEBHOOK_SECRET=
IMAGEKIT_PRIVATE_KEY=
# Ixtiyoriy: sayt manzili (botdagi /start va /menu uchun). Bo'sh qoldirsangiz Netlify manzili olinadi.
SITE_URL=
